\name{RePlei-package}
\alias{RePlei-package}
\docType{package}
\title{
  Fast EM for RePlei model
}
\description{
Run the Expectation-Maximization algorithm to estimate replicability
parameters across multiple correlated traits using GWAS summary statistics.
}
\details{
\strong{Main Functions:}
\itemize{
  \item \code{\link{RePlei}}: Fit the EM model to summary statistics
  \item \code{\link{Get_FDR}}: Compute the false discovery rate (FDR) based on posterior probabilities
}
}
\author{
Yuxuan Wang

Maintainer: Yuxuan Wang <yxw@bu.edu>
}

\references{
Wang, Y., et al. (2025+). RePlei: Replication of Pleiotropic Loci in Genome-Wide Meta-Analysis.
}
\keyword{ package }
